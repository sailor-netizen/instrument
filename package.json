{
  "name": "instrument",
  "version": "0.5.0",
  "description": "A themeable design system where a theme owns structure, not just colour.",
  "license": "MIT",
  "type": "module",
  "sideEffects": [
    "*.css",
    "./src/theme-select.js"
  ],
  "files": [
    "src",
    "gallery",
    "README.md",
    "AUTHORING.md",
    "CHANGELOG.md"
  ],
  "exports": {
    ".": "./src/index.js",
    "./css": "./src/instrument.css",
    "./themes": "./src/themes.js",
    "./theme-select": "./src/theme-select.js",
    "./tokens.css": "./src/tokens.css",
    "./contract.css": "./src/contract.css",
    "./components.css": "./src/components.css",
    "./shell.css": "./src/shell.css",
    "./themes/*.css": "./src/themes/*.css",
    "./package.json": "./package.json",
    "./overlays.css": "./src/overlays.css"
  },
  "peerDependencies": {
    "react": ">=18"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  },
  "scripts": {
    "check": "node scripts/check.mjs",
    "gallery": "node scripts/serve.mjs",
    "embeds": "node embeds/cli.mjs",
    "embeds:validate": "node embeds/validate.mjs",
    "sheets:test": "python3 sheets/test_sheets.py"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/sailor-netizen/instrument.git"
  },
  "keywords": [
    "design-system",
    "css",
    "themes",
    "react",
    "tokens",
    "design-tokens"
  ]
}
